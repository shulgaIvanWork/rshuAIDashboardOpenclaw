<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>РШУ дашборды — админка</title>
  <link rel="stylesheet" href="/style.css?v=3">
  <style>
    .admin-page { padding: 24px; max-width: 1200px; margin: 0 auto; }
    .admin-page h1 { font-size: 24px; margin-bottom: 20px; }
    .users-table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
    .users-table th { background: #1f2a44; color: #fff; padding: 10px 12px; text-align: left; font-size: 12px; font-weight: 600; }
    .users-table td { padding: 10px 12px; border-bottom: 1px solid #eef0f5; font-size: 13px; }
    .users-table tr:hover td { background: #f8f9fc; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }
    .badge-admin { background: #1f2a44; color: #fff; }
    .badge-guest { background: #eef4ff; color: #1976D2; }
    .badge-dash { background: #e8f5e9; color: #2e7d32; font-size: 10px; margin: 1px 2px; padding: 1px 5px; border-radius: 3px; }
    .btn { padding: 6px 14px; border: none; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 500; }
    .btn-primary { background: #C8A45C; color: #fff; }
    .btn-primary:hover { background: #b8943d; }
    .btn-danger { background: #e53935; color: #fff; }
    .btn-danger:hover { background: #c62828; }
    .btn-sm { padding: 4px 10px; font-size: 12px; }
    .btn-outline { background: transparent; border: 1px solid #ccc; color: #555; }
    .btn-outline:hover { background: #f0f0f0; }
    .actions { display: flex; gap: 6px; }
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 1000; align-items: center; justify-content: center; }
    .modal-overlay.active { display: flex; }
    .modal { background: #fff; border-radius: 16px; padding: 28px; width: 500px; max-width: 90vw; box-shadow: 0 8px 32px rgba(0,0,0,.15); max-height: 80vh; overflow-y: auto; }
    .modal h2 { margin: 0 0 16px; font-size: 20px; }
    .modal label { display: block; font-size: 13px; font-weight: 600; margin: 10px 0 4px; color: #555; }
    .modal input, .modal select { width: 100%; padding: 8px 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; box-sizing: border-box; }
    .modal input:focus, .modal select:focus { outline: none; border-color: #C8A45C; }
    .modal .form-actions { display: flex; gap: 8px; margin-top: 18px; justify-content: flex-end; }
    .modal .checkbox-group { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin: 4px 0; }
    .modal .checkbox-group label { font-weight: 400; font-size: 13px; display: flex; align-items: center; gap: 6px; cursor: pointer; margin: 2px 0; }
    .modal .checkbox-group input { width: auto; }
    .password-display { background: #fff8e1; border: 1px solid #ffe082; border-radius: 6px; padding: 10px 14px; margin: 12px 0; }
    .password-display .pwd { font-size: 18px; font-weight: 700; font-family: monospace; letter-spacing: 2px; color: #1f2a44; }
    .password-display .hint { font-size: 11px; color: #888; margin-top: 4px; }
    .empty-state { padding: 40px; text-align: center; color: #888; }
    .toast { position: fixed; bottom: 24px; right: 24px; background: #1f2a44; color: #fff; padding: 12px 20px; border-radius: 8px; font-size: 13px; z-index: 2000; opacity: 0; transition: opacity .3s; }
    .toast.show { opacity: 1; }
  </style>
</head>
<body>
  <div class="app-layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <span class="sidebar-logo">📊 РШУ дашборды</span>
        <span class="sidebar-user"><%= user.name %></span>
      </div>
      <div class="sidebar-spacer"></div>
      <div class="sidebar-footer">
        <a href="/dashboards" class="sidebar-link">📊 Дашборды</a>
        <a href="/admin" class="sidebar-link" style="color:#C8A45C; font-weight:600;">👥 Пользователи</a>
        <a href="/logout" class="sidebar-link logout-link">🚪 Выйти</a>
      </div>
    </aside>

    <main style="flex:1; overflow-y:auto; background:#f4f6fb;">
      <div class="admin-page">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
          <h1>👥 Управление пользователями</h1>
          <button class="btn btn-primary" onclick="openCreate()">➕ Создать</button>
        </div>

        <table class="users-table">
          <thead>
            <tr>
              <th>Логин</th>
              <th>Имя</th>
              <th>Роль</th>
              <th>Доступ к дашбордам</th>
              <th>Действия</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(u) { %>
            <tr data-id="<%= u.id %>">
              <td><code><%= u.id %></code></td>
              <td><%= u.name %></td>
              <td><span class="badge <%= u.role === 'admin' ? 'badge-admin' : 'badge-guest' %>"><%= u.role === 'admin' ? 'Админ' : 'Гость' %></span></td>
              <td>
                <% if (u.role === 'admin') { %>
                  <span style="color:#888;font-size:12px;">все</span>
                <% } else if (u.dashboards && u.dashboards.length > 0) { %>
                  <% u.dashboards.forEach(function(d) { %>
                    <span class="badge badge-dash"><%= d %></span>
                  <% }); %>
                <% } else { %>
                  <span style="color:#888;font-size:12px;">все опубликованные</span>
                <% } %>
              </td>
              <td>
                <div class="actions">
                  <button class="btn btn-sm btn-outline" onclick="openEdit('<%= u.id %>')">✏️</button>
                  <% if (u.role !== 'admin') { %>
                  <button class="btn btn-sm btn-outline" onclick="resetPassword('<%= u.id %>')">🔑</button>
                  <button class="btn btn-sm btn-danger" onclick="deleteUser('<%= u.id %>')">🗑️</button>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <!-- Modal: Create/Edit -->
  <div class="modal-overlay" id="userModal">
    <div class="modal">
      <h2 id="modalTitle">Создать пользователя</h2>
      <input type="hidden" id="editId">
      
      <label for="modalId">Логин</label>
      <input type="text" id="modalId" placeholder="client_name" pattern="[a-zA-Z0-9_-]+" required>
      
      <label for="modalName">Имя</label>
      <input type="text" id="modalName" placeholder="ООО Клиент">

      <label for="modalRole">Роль</label>
      <select id="modalRole" onchange="toggleDashboardsField()">
        <option value="guest">Гость</option>
        <option value="admin">Админ</option>
      </select>

      <div id="dashboardsField">
        <label>Доступ к дашбордам</label>
        <div class="checkbox-group" id="dashboardsCheckboxes">
          <% dashboards.forEach(function(d) { %>
            <label>
              <input type="checkbox" class="dash-chk" value="<%= d.name %>">
              <%= d.label %> <% if (d.status === 'draft') { %><span style="color:#aaa;font-size:10px;">(черновик)</span><% } %>
            </label>
          <% }); %>
        </div>
        <div style="font-size:11px;color:#888;margin-top:4px;">оставьте пустым — будут видны все опубликованные</div>
      </div>

      <div id="passwordDisplay" class="password-display" style="display:none;">
        <div class="hint">🔑 Сгенерированный пароль (показывается один раз):</div>
        <div class="pwd" id="generatedPassword"></div>
      </div>

      <div class="form-actions">
        <button class="btn btn-outline" onclick="closeModal()">Отмена</button>
        <button class="btn btn-primary" id="modalSaveBtn" onclick="saveUser()">Сохранить</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div class="toast" id="toast"></div>

  <script>
    const allDashboards = <%- JSON.stringify(dashboards.map(d => ({ name: d.name, label: d.label, status: d.status }))) %>;
    
    function openCreate() {
      document.getElementById('modalTitle').textContent = '➕ Создать пользователя';
      document.getElementById('editId').value = '';
      document.getElementById('modalId').value = '';
      document.getElementById('modalId').disabled = false;
      document.getElementById('modalName').value = '';
      document.getElementById('modalRole').value = 'guest';
      document.getElementById('passwordDisplay').style.display = 'none';
      document.getElementById('generatedPassword').textContent = '';
      document.getElementById('modalSaveBtn').textContent = 'Создать';
      toggleDashboardsField();
      document.querySelectorAll('.dash-chk').forEach(c => c.checked = false);
      document.getElementById('userModal').classList.add('active');
    }

    function openEdit(id) {
      document.getElementById('modalTitle').textContent = '✏️ Редактировать пользователя';
      document.getElementById('editId').value = id;
      document.getElementById('modalId').value = id;
      document.getElementById('modalId').disabled = true;
      document.getElementById('passwordDisplay').style.display = 'none';
      document.getElementById('generatedPassword').textContent = '';
      document.getElementById('modalSaveBtn').textContent = 'Сохранить';

      const row = document.querySelector(`tr[data-id="${id}"]`);
      const name = row.querySelector('td:nth-child(2)').textContent;
      const isAdmin = row.querySelector('.badge-admin') !== null;
      
      document.getElementById('modalName').value = name;
      document.getElementById('modalRole').value = isAdmin ? 'admin' : 'guest';
      toggleDashboardsField();
      
      // Check the appropriate dashboards
      document.querySelectorAll('.dash-chk').forEach(c => c.checked = false);
      if (!isAdmin) {
        row.querySelectorAll('.badge-dash').forEach(function(b) {
          const chk = document.querySelector(`.dash-chk[value="${b.textContent.trim()}"]`);
          if (chk) chk.checked = true;
        });
      }
      
      document.getElementById('userModal').classList.add('active');
    }

    function toggleDashboardsField() {
      const role = document.getElementById('modalRole').value;
      document.getElementById('dashboardsField').style.display = role === 'admin' ? 'none' : 'block';
    }

    function closeModal() {
      document.getElementById('userModal').classList.remove('active');
    }

    async function saveUser() {
      const id = document.getElementById('editId').value || document.getElementById('modalId').value;
      const name = document.getElementById('modalName').value;
      const role = document.getElementById('modalRole').value;
      const isCreate = !document.getElementById('editId').value;

      if (!id || !name) { showToast('Заполните логин и имя'); return; }
      if (!/^[a-zA-Z0-9_-]+$/.test(id)) { showToast('Логин: только буквы, цифры, -, _'); return; }

      let dashboards = [];
      if (role === 'guest') {
        document.querySelectorAll('.dash-chk:checked').forEach(c => dashboards.push(c.value));
      }

      if (isCreate) {
        // Create
        const res = await fetch('/api/admin/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, name, role, dashboards })
        });
        const data = await res.json();
        if (!data.ok) { showToast('❌ ' + (data.error || 'Ошибка')); return; }
        
        if (data.generatedPassword) {
          document.getElementById('generatedPassword').textContent = data.generatedPassword;
          document.getElementById('passwordDisplay').style.display = 'block';
          document.getElementById('modalSaveBtn').textContent = 'Закрыть';
          document.getElementById('modalSaveBtn').onclick = closeModal;
          return;
        }
      } else {
        // Update
        const res = await fetch('/api/admin/users/' + encodeURIComponent(id), {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, role, dashboards })
        });
        const data = await res.json();
        if (!data.ok) { showToast('❌ ' + (data.error || 'Ошибка')); return; }
      }

      closeModal();
      showToast('✅ Сохранено');
      setTimeout(() => location.reload(), 500);
    }

    async function resetPassword(id) {
      if (!confirm('Сбросить пароль для "' + id + '"?')) return;
      
      const newPassword = Math.random().toString(36).slice(2, 10) + Math.random().toString(36).slice(2, 4);
      const res = await fetch('/api/admin/users/' + encodeURIComponent(id), {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ newPassword })
      });
      const data = await res.json();
      if (!data.ok) { showToast('❌ ' + (data.error || 'Ошибка')); return; }
      
      showToast('🔑 Новый пароль для ' + id + ': ' + newPassword, 15000);
    }

    async function deleteUser(id) {
      if (!confirm('Удалить пользователя "' + id + '"? Это действие необратимо.')) return;
      
      const res = await fetch('/api/admin/users/' + encodeURIComponent(id), { method: 'DELETE' });
      const data = await res.json();
      if (!data.ok) { showToast('❌ ' + (data.error || 'Ошибка')); return; }
      
      showToast('✅ Пользователь удалён');
      setTimeout(() => location.reload(), 500);
    }

    function showToast(msg, duration) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      clearTimeout(t._timeout);
      t._timeout = setTimeout(() => t.classList.remove('show'), duration || 3000);
    }

    // Close modal on overlay click
    document.getElementById('userModal').addEventListener('click', function(e) {
      if (e.target === this) closeModal();
    });
  </script>
</body>
</html>
