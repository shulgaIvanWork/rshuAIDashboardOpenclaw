<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Дашборды РШУ - пользователи</title>
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/shared.css">
  <link rel="stylesheet" href="/ui-kit/ds.css">
  <style>
    .adm-table-card { padding: 0; overflow: hidden; }
    .adm-table td, .adm-table th { vertical-align: middle; padding: 10px 14px; }
    .adm-table thead tr:first-child th { border-radius: 0; }
    .adm-badges { display: flex; flex-wrap: wrap; gap: 4px; }
    .adm-dash-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 6px 16px; }
    .adm-pw { display: inline-flex; align-items: center; gap: 4px; }
  </style>
</head>
<body class="app-chrome">
  <%- include('partials/topbar', { user: { name: user.name, role: 'admin' }, active: 'admin' }) %>

  <main class="ds-page">
    <div class="ds-page-head">
      <h1 class="ds-title">Пользователи</h1>
      <button class="ds-btn ds-btn--primary" type="button" onclick="openCreate()">
        <svg class="ds-icon" aria-hidden="true"><use href="/ui-kit/icons.svg#i-plus"></use></svg>Создать
      </button>
    </div>

    <div class="ds-card adm-table-card">
      <div class="scroll-x">
        <table class="adm-table">
          <thead>
            <tr>
              <th>Логин</th>
              <th>Имя</th>
              <th>Роль</th>
              <th>Пароль</th>
              <th>Доступ к дашбордам</th>
              <th>Действия</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(u) { %>
            <tr data-id="<%= u.id %>">
              <td class="ds-mono"><%= u.id %></td>
              <td><%= u.name %></td>
              <td><span class="ds-badge <%= u.role === 'admin' ? 'ds-badge--primary' : 'ds-badge--info' %>"><%= u.role === 'admin' ? 'Админ' : 'Гость' %></span></td>
              <td>
                <% if (u.password) { %>
                  <span class="adm-pw">
                    <span class="ds-mono pw-mask" data-pw="<%= u.password %>">••••••••</span>
                    <button class="ds-btn ds-btn--ghost ds-btn--sm ds-btn--icon pw-toggle" type="button" title="Показать или скрыть" aria-label="Показать или скрыть пароль"><svg class="ds-icon" aria-hidden="true"><use href="/ui-kit/icons.svg#i-eye"></use></svg></button>
                    <button class="ds-btn ds-btn--ghost ds-btn--sm ds-btn--icon pw-copy" type="button" title="Скопировать" aria-label="Скопировать пароль"><svg class="ds-icon" aria-hidden="true"><use href="/ui-kit/icons.svg#i-copy"></use></svg></button>
                  </span>
                <% } else { %>
                  <span class="ds-muted" style="font-size:12px">скрыт (старый), сбросьте пароль</span>
                <% } %>
              </td>
              <td>
                <% if (u.role === 'admin') { %>
                  <span class="ds-muted" style="font-size:12px">все</span>
                <% } else if (u.dashboards && u.dashboards.length > 0) { %>
                  <span class="adm-badges">
                  <% u.dashboards.forEach(function(d) { %>
                    <span class="ds-badge ds-badge--success"><%= d %></span>
                  <% }); %>
                  </span>
                <% } else { %>
                  <span class="ds-badge ds-badge--danger">нет доступа</span>
                <% } %>
              </td>
              <td>
                <div class="ds-row" style="gap:4px;flex-wrap:nowrap">
                  <button class="ds-btn ds-btn--ghost ds-btn--sm ds-btn--icon" type="button" title="Изменить" aria-label="Изменить" onclick="openEdit('<%= u.id %>')"><svg class="ds-icon" aria-hidden="true"><use href="/ui-kit/icons.svg#i-edit"></use></svg></button>
                  <% if (u.role !== 'admin') { %>
                  <button class="ds-btn ds-btn--ghost ds-btn--sm ds-btn--icon" type="button" title="Сбросить пароль" aria-label="Сбросить пароль" onclick="resetPassword('<%= u.id %>')"><svg class="ds-icon" aria-hidden="true"><use href="/ui-kit/icons.svg#i-key"></use></svg></button>
                  <button class="ds-btn ds-btn--danger ds-btn--sm ds-btn--icon" type="button" title="Удалить" aria-label="Удалить" onclick="deleteUser('<%= u.id %>')"><svg class="ds-icon" aria-hidden="true"><use href="/ui-kit/icons.svg#i-trash"></use></svg></button>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- Modal: Create/Edit -->
  <div class="ds-modal" id="userModal">
    <div class="ds-modal__box">
      <h2 class="ds-modal__title" id="modalTitle">Создать пользователя</h2>
      <input type="hidden" id="editId">

      <div class="ds-field">
        <label for="modalId" class="ds-label">Логин</label>
        <input type="text" id="modalId" class="ds-input" placeholder="client_name" pattern="[a-zA-Z0-9_-]+" required>
      </div>

      <div class="ds-field">
        <label for="modalName" class="ds-label">Имя</label>
        <input type="text" id="modalName" class="ds-input" placeholder="ООО Клиент">
      </div>

      <div class="ds-field">
        <label for="modalPassword" class="ds-label" id="modalPasswordLabel">Пароль</label>
        <div class="ds-row" style="flex-wrap:nowrap">
          <input type="text" id="modalPassword" class="ds-input ds-mono" placeholder="">
          <button class="ds-btn ds-btn--ghost" type="button" onclick="genPassword()">
            <svg class="ds-icon" aria-hidden="true"><use href="/ui-kit/icons.svg#i-shuffle"></use></svg>Сгенерировать
          </button>
        </div>
        <span class="ds-hint" id="modalPasswordHint">Если оставить пустым, пароль сгенерируется автоматически.</span>
      </div>

      <div class="ds-field">
        <label for="modalRole" class="ds-label">Роль</label>
        <select id="modalRole" class="ds-select" onchange="toggleDashboardsField()">
          <option value="guest">Гость</option>
          <option value="admin">Админ</option>
        </select>
      </div>

      <div id="dashboardsField" class="ds-field">
        <span class="ds-label">Доступ к дашбордам</span>
        <div class="adm-dash-list" id="dashboardsCheckboxes">
          <% dashboards.forEach(function(d) { %>
            <label class="ds-check" for="chk_<%= d.name %>">
              <input type="checkbox" class="dash-chk" id="chk_<%= d.name %>" value="<%= d.name %>"><%= d.label %>
            </label>
          <% }); %>
        </div>
        <span class="ds-hint">Выберите хотя бы один, иначе у гостя <b>нет доступа</b> ни к одному дашборду</span>
      </div>

      <div id="passwordDisplay" class="ds-alert ds-alert--warning" style="display:none;margin-top:12px">
        <div>
          <div style="font-size:12px">Сгенерированный пароль (показывается один раз):</div>
          <div class="ds-mono" style="font-size:18px;font-weight:700" id="generatedPassword"></div>
        </div>
      </div>

      <div class="ds-modal__actions">
        <button class="ds-btn ds-btn--ghost" type="button" onclick="closeModal()">Отмена</button>
        <button class="ds-btn ds-btn--primary" type="button" id="modalSaveBtn" onclick="saveUser()">Сохранить</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div class="ds-toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    const allDashboards = <%- JSON.stringify(dashboards.map(d => ({ name: d.name, label: d.label }))) %>;
    const USERS = <%- JSON.stringify(users) %>;

    function genPassword() {
      const chars = 'abcdefghjkmnpqrstuvwxyzABCDEFGHJKMNPQRSTUVWXYZ23456789';
      let p = '';
      for (let i = 0; i < 10; i++) p += chars[Math.floor(Math.random() * chars.length)];
      document.getElementById('modalPassword').value = p;
    }

    // Показать/скрыть и скопировать пароль в таблице
    document.addEventListener('click', function(e) {
      const tog = e.target.closest('.pw-toggle');
      if (tog) {
        const span = tog.closest('td').querySelector('.pw-mask');
        const shown = span.dataset.shown === '1';
        span.textContent = shown ? '••••••••' : span.dataset.pw;
        span.dataset.shown = shown ? '0' : '1';
        return;
      }
      const cp = e.target.closest('.pw-copy');
      if (cp) {
        const pw = cp.closest('td').querySelector('.pw-mask').dataset.pw;
        navigator.clipboard.writeText(pw).then(() => showToast('Пароль скопирован'));
      }
    });

    function openCreate() {
      document.getElementById('modalTitle').textContent = 'Создать пользователя';
      document.getElementById('editId').value = '';
      document.getElementById('modalId').value = '';
      document.getElementById('modalId').disabled = false;
      document.getElementById('modalName').value = '';
      document.getElementById('modalPassword').value = '';
      document.getElementById('modalPasswordHint').textContent = 'Если оставить пустым, пароль сгенерируется автоматически.';
      document.getElementById('modalRole').value = 'guest';
      document.getElementById('passwordDisplay').style.display = 'none';
      document.getElementById('generatedPassword').textContent = '';
      document.getElementById('modalSaveBtn').textContent = 'Создать';
      document.getElementById('modalSaveBtn').onclick = saveUser;
      toggleDashboardsField();
      document.querySelectorAll('.dash-chk').forEach(c => c.checked = false);
      document.getElementById('userModal').classList.add('active');
    }

    function openEdit(id) {
      const u = USERS.find(x => x.id === id);
      if (!u) return;
      document.getElementById('modalTitle').textContent = 'Редактировать пользователя';
      document.getElementById('editId').value = id;
      document.getElementById('modalId').value = id;
      document.getElementById('modalId').disabled = true;
      document.getElementById('passwordDisplay').style.display = 'none';
      document.getElementById('generatedPassword').textContent = '';
      document.getElementById('modalSaveBtn').textContent = 'Сохранить';
      document.getElementById('modalSaveBtn').onclick = saveUser;

      document.getElementById('modalName').value = u.name || '';
      // Пароль: показываем текущий (если открытый); для старого хеша - пусто с подсказкой
      document.getElementById('modalPassword').value = u.password || '';
      document.getElementById('modalPasswordHint').textContent = u.password
        ? 'Можно изменить. Если оставить пустым, пароль не изменится.'
        : 'Старый пароль скрыт (хеш). Введите новый или оставьте пустым.';
      document.getElementById('modalRole').value = u.role === 'admin' ? 'admin' : 'guest';
      toggleDashboardsField();

      document.querySelectorAll('.dash-chk').forEach(c => c.checked = false);
      (u.dashboards || []).forEach(function(name) {
        const chk = document.querySelector(`.dash-chk[value="${name}"]`);
        if (chk) chk.checked = true;
      });

      document.getElementById('userModal').classList.add('active');
    }

    function toggleDashboardsField() {
      const role = document.getElementById('modalRole').value;
      document.getElementById('dashboardsField').style.display = role === 'admin' ? 'none' : 'flex';
    }

    function closeModal() {
      document.getElementById('userModal').classList.remove('active');
    }

    async function saveUser() {
      const id = document.getElementById('editId').value || document.getElementById('modalId').value;
      const name = document.getElementById('modalName').value;
      const role = document.getElementById('modalRole').value;
      const isCreate = !document.getElementById('editId').value;

      if (!id || !name) { showToast('Заполните логин и имя'); return; }
      if (!/^[a-zA-Z0-9_-]+$/.test(id)) { showToast('Логин: только буквы, цифры, -, _'); return; }

      const password = document.getElementById('modalPassword').value.trim();

      let dashboards = [];
      if (role === 'guest') {
        document.querySelectorAll('.dash-chk:checked').forEach(c => dashboards.push(c.value));
      }

      if (isCreate) {
        // Create
        const res = await fetch('/api/admin/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, name, role, dashboards, password })
        });
        const data = await res.json();
        if (!data.ok) { showToast('Ошибка: ' + (data.error || 'не удалось сохранить')); return; }

        if (data.generatedPassword) {
          document.getElementById('generatedPassword').textContent = data.generatedPassword;
          document.getElementById('passwordDisplay').style.display = 'flex';
          document.getElementById('modalSaveBtn').textContent = 'Закрыть';
          document.getElementById('modalSaveBtn').onclick = () => location.reload();
          return;
        }
      } else {
        // Update (newPassword пусто = не менять)
        const res = await fetch('/api/admin/users/' + encodeURIComponent(id), {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, role, dashboards, newPassword: password })
        });
        const data = await res.json();
        if (!data.ok) { showToast('Ошибка: ' + (data.error || 'не удалось сохранить')); return; }
      }

      closeModal();
      showToast('Сохранено');
      setTimeout(() => location.reload(), 500);
    }

    async function resetPassword(id) {
      if (!confirm('Сгенерировать новый пароль для "' + id + '"?')) return;
      const res = await fetch('/api/admin/users/' + encodeURIComponent(id), {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ resetPassword: true })
      });
      const data = await res.json();
      if (!data.ok) { showToast('Ошибка: ' + (data.error || 'не удалось сбросить пароль')); return; }
      showToast('Новый пароль для ' + id + ': ' + data.generatedPassword, 15000);
      setTimeout(() => location.reload(), 2500);
    }

    async function deleteUser(id) {
      if (!confirm('Удалить пользователя "' + id + '"? Это действие необратимо.')) return;

      const res = await fetch('/api/admin/users/' + encodeURIComponent(id), { method: 'DELETE' });
      const data = await res.json();
      if (!data.ok) { showToast('Ошибка: ' + (data.error || 'не удалось удалить')); return; }

      showToast('Пользователь удален');
      setTimeout(() => location.reload(), 500);
    }

    function showToast(msg, duration) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      clearTimeout(t._timeout);
      t._timeout = setTimeout(() => t.classList.remove('show'), duration || 3000);
    }

    // Close modal on overlay click
    document.getElementById('userModal').addEventListener('click', function(e) {
      if (e.target === this) closeModal();
    });
  </script>
</body>
</html>
