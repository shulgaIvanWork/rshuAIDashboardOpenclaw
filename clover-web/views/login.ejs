<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Дашборды РШУ - вход</title>
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/shared.css">
  <link rel="stylesheet" href="/ui-kit/ds.css">
</head>
<body class="app-chrome">
  <main class="ds-login">
    <div class="ds-login__card">
      <img class="ds-login__logo" src="/ui-kit/logo.svg" alt="Российская школа управления">
      <h1 class="ds-login__title">Дашборды РШУ</h1>
      <p class="ds-login__sub">Войдите, чтобы открыть дашборды</p>
      <% if (locals.error) { %>
        <div class="ds-alert ds-alert--danger" role="alert" style="margin-bottom:16px">
          <svg class="ds-icon" aria-hidden="true"><use href="/ui-kit/icons.svg#i-warning"></use></svg><span><%= error %></span>
        </div>
      <% } %>
      <form method="POST" action="/login">
        <div class="ds-field">
          <label for="username" class="ds-label">Логин</label>
          <input type="text" id="username" name="username" class="ds-input" placeholder="Логин" autocomplete="username" required autofocus>
        </div>
        <div class="ds-field">
          <label for="password" class="ds-label">Пароль</label>
          <input type="password" id="password" name="password" class="ds-input" placeholder="Пароль" autocomplete="current-password" required>
        </div>
        <button type="submit" class="ds-btn ds-btn--primary ds-btn--lg ds-btn--block" style="margin-top:8px">Войти</button>
      </form>
    </div>
  </main>
</body>
</html>
