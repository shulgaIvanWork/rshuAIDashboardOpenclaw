<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>📊 Дашборды — uprav.tech</title>
  <link rel="stylesheet" href="/style.css?v=5">
</head>
<body>
  <div class="app-layout">
    <header class="topbar">
      <div class="topbar-left">
        <span class="topbar-logo">📊 РШУ</span>
        <span class="topbar-separator">|</span>
        <span class="topbar-user"><%= user.name %><% if (user.role === 'guest') { %> <span class="topbar-guest">(гость)</span><% } %></span>
      </div>
      <nav class="topbar-nav">
        <a href="/dashboards" class="topbar-link active">📊 Дашборды</a>
        <% if (user.role === 'admin') { %><a href="/admin" class="topbar-link">👥 Пользователи</a><% } %>
        <a href="/logout" class="topbar-link logout-link">🚪 Выйти</a>
      </nav>
    </header>

    <main class="main-content">
      <div class="dashboards-page">
        <h1>📊 Дашборды</h1>
        <% dashboards.forEach(function(d) { %>
          <a href="<%= d.url %>" target="_blank" class="dashboard-card">
            <span class="dashboard-icon"><%= d.icon %></span>
            <span class="dashboard-title"><%= d.description %></span>
          </a>
        <% }) %>
        <% if (dashboards.length === 0) { %>
          <p class="empty-msg">Нет доступных дашбордов</p>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>
