<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Дашборды - uprav.tech</title>
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/shared.css">
  <link rel="stylesheet" href="/ui-kit/ds.css">
</head>
<body class="app-chrome">
  <%- include('partials/topbar', { user: user, active: 'dashboards' }) %>

  <main class="ds-page ds-page--narrow">
    <div class="ds-page-head">
      <h1 class="ds-title">Дашборды</h1>
    </div>
    <% if (dashboards.length === 0) { %>
      <div class="ds-card ds-muted" style="text-align:center;padding:48px 20px">Нет доступных дашбордов</div>
    <% } else { %>
      <div class="ds-grid">
        <% dashboards.forEach(function(d) { %>
          <a href="<%= d.url %>" target="_blank" class="ds-tile">
            <span class="ds-tile__icon"><svg class="ds-icon" aria-hidden="true"><use href="/ui-kit/icons.svg#<%= d.icon %>"></use></svg></span>
            <span class="ds-tile__title"><%= d.description %></span>
            <svg class="ds-icon ds-tile__arrow" aria-hidden="true"><use href="/ui-kit/icons.svg#i-chevron-right"></use></svg>
          </a>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>
