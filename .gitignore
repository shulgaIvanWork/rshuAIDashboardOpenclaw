# Environment
.env

# Dependencies — npm workspaces: корень + локальные воркспейсы
node_modules/

# Кэш данных из Bitrix (генерируется data-service при запуске)
data-service/cache/

# Runtime-кэш дашбордов
dashboards/*/cache/
dashboards/*/output/

# Runtime (сессии пользователей)
clover-web/data/sessions/*

# Чувствительные данные (пароли, база пользователей)
clover-web/data/users.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Python (старые скрипты)
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# OpenClaw / автономный агент — служебные файлы, не относятся к проекту
.openclaw/
.dreams/
memory/
sessions/
backups/
backup/
projects/
heartbeat-state.json
openclaw-workspace-state.json
*.migrated
AGENTS.md
SOUL.md
IDENTITY.md
TOOLS.md
HEARTBEAT.md
USER.md

# PM2
pm2-logrotate/

# Cache & temp
*.tmp
cron/
inbox/
outbox/

.claude
